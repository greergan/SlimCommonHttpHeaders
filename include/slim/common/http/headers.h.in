#ifndef SLIM_COMMON_HTTP_HEADERS_H
#define SLIM_COMMON_HTTP_HEADERS_H

#include <memory>
#include <string_view>
#include <vector>

#include <slim/common/http/header.h>
#include <slim/common/http/cookie/store.h>

#define SLIMCOMMONHTTPHEADERS_VERSION  "@SLIMCOMMONHTTPHEADERS_VERSION@"
#define SLIMCOMMONHTTPHEADERS_GIT_HASH "@SLIMCOMMONHTTPHEADERS_GIT_HASH@"

namespace slim::common::http {

class Headers {
public:
    HeaderStatus append(std::string_view key, std::string_view value) noexcept;
    HeaderStatus erase(std::string_view key) noexcept;
    std::shared_ptr<Header> get(std::string_view key) const noexcept;
    bool has(std::string_view key) const noexcept;
    HeaderStatus set(std::string_view key, std::string_view value) noexcept;
    const std::vector<std::shared_ptr<Header>>&  entries() const noexcept { return headers; }
    const std::shared_ptr<CookieStore>& get_cookies() const noexcept { return cookies; }

private:
    std::vector<std::shared_ptr<Header>> headers{};
    std::shared_ptr<CookieStore>         cookies{};
};

} // namespace slim::common::http

#endif // SLIM_COMMON_HTTP_HEADERS_H
